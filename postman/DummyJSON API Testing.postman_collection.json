  "item": [
    {
      "name": "01-Users",
      "item": [
        {
          "name": "TC-001 - Get Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response is JSON\", function(){\r\n    pm.response.to.be.json;\r\n});\r\n\r\npm.test(\"Response contains users array\", function() {\r\n    const body = pm.response.json();\r\n    pm.expect(body.users).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"Exactly 5 users are returned\", function() {\r\n    const body = pm.response.json();\r\n    pm.expect(body.users.length).to.eql(5);\r\n});\r\n\r\npm.test(\"Pagination values are correct\", function() {\r\n    const body = pm.response.json();\r\n    \r\n    pm.expect(body.total).to.be.a(\"number\");\r\n    pm.expect(body.skip).to.eql(0);\r\n    pm.expect(body.limit).to.eql(5);\r\n});\r\n\r\npm.test(\"Each user contains required fields\", function() {\r\n    const body = pm.response.json();\r\n\r\n    body.users.forEach(function (user) {\r\n        pm.expect(user).to.have.property(\"id\");\r\n        pm.expect(user).to.have.property(\"firstName\");\r\n        pm.expect(user).to.have.property(\"lastName\");\r\n        pm.expect(user).to.have.property(\"email\");\r\n    });\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://dummyjson.com/users?limit=5",
              "protocol": "https",
              "host": [
                "dummyjson",
                "com"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          },
          "response": []
        },
        {
